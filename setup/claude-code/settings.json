{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": false
  },
  "model": "opus",
  "enabledPlugins": {
    "portal@portal": false,
    "shunt@portal": true,
    "ponytail@ponytail": true,
    "frontend-design@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "humanizer@humanizer": true,
    "brag@brag": true,
    "mattpocock-skills@mattpocock": true,
    "pm-skills@pm-skills-marketplace": true
  },
  "extraKnownMarketplaces": {
    "portal": {
      "source": {
        "source": "github",
        "repo": "spotify/portal-ai-plugins"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "brag": {
      "source": {
        "source": "github",
        "repo": "latent-spaces/brag"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "pm-skills-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/product-on-purpose/pm-skills.git"
      }
    }
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ~/.claude/hooks/skill-finder.py",
            "timeout": 5,
            "statusMessage": "Finding skills for this prompt"
          }
        ]
      }
    ]
  }
}