  "tabs": [
    {
      "kind": "page",
      "id": "t_week",
      "title": "This week",
      "children": [
        {
          "kind": "days",
          "id": "b_week",
          "source": "*dated",
          "views": [
            "week"
          ],
          "view": "week",
          "apps": [
            "classes"
          ]
        }
      ]
    },
    {
      "kind": "page",
      "id": "t_due",
      "title": "Due",
      "children": [
        {
          "kind": "checklist",
          "id": "b_due",
          "source": "classes/due",
          "fields": [
            "class",
            "at"
          ],
          "due": "at",
          "groups": [
            {
              "label": "Coming up",
              "where": [
                {
                  "field": "done",
                  "op": "eq",
                  "value": false
                },
                {
                  "field": "kind",
                  "op": "eq",
                  "value": "assignment"
                }
              ]
            },
            {
              "label": "Done · {n}",
              "where": [
                {
                  "field": "done",
                  "op": "eq",
                  "value": true
                }
              ],
              "done": true,
              "collapsed": true
            }
          ],
          "swipe": {
            "right": "complete"
          }
        }
      ]
    },
    {
      "kind": "page",
      "id": "t_exams",
      "title": "Exams",
      "children": [
        {
          "kind": "list",
          "id": "b_exams",
          "source": "classes/due",
          "fields": [
            "class",
            "at"
          ],
          "sort": {
            "field": "at",
            "dir": "asc"
          },
          "where": [
            {
              "field": "kind",
              "op": "eq",
              "value": "exam"
            }
          ]
        }
      ]
    }
  ],
  "face": {
    "value": {
      "agg": "count",
      "from": "classes/due",
      "where": [
        {
          "field": "done",
          "op": "eq",
          "value": false
        },
        {
          "field": "at",
          "op": "within",
          "value": "7d"
        }
      ]
    },
    "format": "count",
    "label": "due this week"
  },
  "stitches": []
}
